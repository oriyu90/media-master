<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base XML theme. AppCompat is required because MainActivity extends
         AppCompatActivity for per-app locales (AppCompatDelegate.setApplicationLocales).
         All actual colouring is done in Compose (MediaMasterTheme); this only needs
         to be a no-action-bar, edge-to-edge-friendly shell. -->
    <style name="Theme.MediaMaster" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!-- Backwards-compatible alias for the old name still referenced by the manifest. -->
    <style name="Theme.MyApplication" parent="Theme.MediaMaster" />
</resources>
